# Dream Player theme: color tokens substituted into style.css ({{token}}).
# Copy this file under a new name (e.g. mytheme.theme) to make a theme; it
# appears in Settings → Theme. Missing tokens fall back to this dark theme.

name = Dark

# surfaces
bg          = #000000
surface     = #0c0c0c
surface_alt = #161616
border      = #232323

# text
text        = #e9e9e9
muted       = #8b8b8b

# accent: progress, waves, active states
accent      = #1ed760
accent_text = #000000

# states
warning     = #f5c400
error       = #ff4d4f
