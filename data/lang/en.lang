# ── about ──
about.tagline = A player for the music on your devices — offline, light, with sync between devices.
about.features = FEATURES
about.feature.1 = Playlists, the library, the song overview; a queue with shuffle and repeat
about.feature.2 = Playlist editor: order, cover, search, preview
about.feature.3 = Tag and cover editing, written into the file itself; per-song volume, color and label marks
about.feature.4 = Import and export of the library, playlists and songs as .dplr packets
about.feature.5 = Sync and transfer between devices: Wi-Fi / LAN, USB through adb; encryption by the core
about.feature.6 = System media controls over D-Bus (MPRIS): media keys, the desktop player widget
about.feature.7 = Mods from the core (pre-alpha): menu actions and tabs
about.feature.8 = Localization from text files, themes from text files
about.feature.9 = Rust core (indexing, playback, tags, sync); GTK 4 / gtkmm interface in C++
about.versions = VERSIONS
about.app = App
about.core = Core
about.gtk = GTK
about.repos = SOURCE CODE
